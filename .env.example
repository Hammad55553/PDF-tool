# ==============================================
# PDForo — Environment Variables
# Copy this file to .env.local and fill in real values.
# ==============================================

# ---- App ----
# Your live URL (used for SEO/sitemap/OG + Stripe redirects).
# Local: http://localhost:3000  •  Production: https://pdforo.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (payments) ----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# One Price ID per (plan x billing period). Add a monthly + yearly recurring
# price to each product in Stripe, then paste the IDs here.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PRICE_ID_ULTRA_MONTHLY=
STRIPE_PRICE_ID_ULTRA_YEARLY=

# ---- Supabase (auth + plan tracking) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (Stripe webhook) — never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google AdSense (best long-term; needs approval) ----
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# ---- Adsterra (instant fallback; only used if AdSense above is empty) ----
# Clean banner format only. Key + size from your Adsterra banner ad unit.
NEXT_PUBLIC_ADSTERRA_KEY=
NEXT_PUBLIC_ADSTERRA_WIDTH=728
NEXT_PUBLIC_ADSTERRA_HEIGHT=90

# ---- Background Remover ----
# Optional: remove.bg API key for higher-quality removal (falls back to the
# free local rembg engine when empty or out of credits). https://www.remove.bg/api
REMOVE_BG_API_KEY=
# Optional: path to python3 if not on PATH (for the rembg fallback).
# PYTHON_BIN=
